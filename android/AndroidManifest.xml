<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />




<!-- 支持http 或者ip地址需要这个配置  sdk28之后的-->
<!--    android:usesCleartextTraffic="true"-->

    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application
        android:name="com.joker.puzzle.BaseApplication"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:isGame="true"
        android:usesCleartextTraffic="true"
        android:appCategory="game"
        android:label="@string/app_name"
        android:largeHeap="true">

        <activity
            android:name="com.joker.puzzle.AndroidLauncher"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|navigation|uiMode|fontScale|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.joker.puzzle.demo.KeyboardHeightCaseDemoActivity"
            android:label="@string/keyboard_case_title"
            android:exported="true"
            android:screenOrientation="portrait" />

        <service android:name="com.joker.puzzle.wallpaper.MuyuWallpaperService"
            android:process=":wallpaper_muyu" android:exported="true"
            android:label="@string/wallpaper_muyu" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>
        <service android:name="com.joker.puzzle.wallpaper.SeasonsWallpaperService"
            android:process=":wallpaper_seasons" android:exported="true"
            android:label="@string/wallpaper_seasons" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>
        <service android:name="com.joker.puzzle.wallpaper.CityWallpaperService"
            android:process=":wallpaper_city" android:exported="true"
            android:label="@string/wallpaper_city" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_provider_paths" />
        </provider>
    </application>

</manifest>
